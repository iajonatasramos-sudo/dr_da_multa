# Todas as variáveis NEXT_PUBLIC_* são gravadas no HTML/JS na hora do build.
# Mudou alguma? Faça um novo deploy (no Dokploy: Build Args + Redeploy).

# Domínio público, sem barra no final (usado em canonical, Open Graph e sitemap)
NEXT_PUBLIC_SITE_URL=https://telecomadv.academy

# Webhook do n8n que recebe o cadastro da lista de espera da imersão (POST JSON)
NEXT_PUBLIC_WAITLIST_WEBHOOK_URL=

# Webhook do n8n que recebe o lead (POST JSON)
NEXT_PUBLIC_LEAD_WEBHOOK_URL=https://n8n.seudominio.com/webhook/telecom-adv-lead

# Link de convite do grupo de WhatsApp
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXXXX

# Link do PDF do e-book (pode ser /ebook/o-mar-azul-da-advocacia.pdf se o arquivo estiver em public/)
NEXT_PUBLIC_EBOOK_URL=/ebook/o-mar-azul-da-advocacia.pdf

# WhatsApp de atendimento (só dígitos, com 55 + DDD), usado na mensagem de erro do formulário
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511973733366

# Rastreamento
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# ID do vídeo do YouTube do Jason na página de obrigado (ex.: dQw4w9WgXcQ). Vazio = bloco oculto.
NEXT_PUBLIC_YOUTUBE_VIDEO_ID=

# ---- Imersão (/imersao) ----
# Checkout do ingresso na Hotmart (o VIP aparece como order bump)
NEXT_PUBLIC_HOTMART_CHECKOUT_URL=https://pay.hotmart.com/XXXXXXXX
# Opcional: checkout com o VIP já selecionado. Vazio = os dois botões usam o checkout acima
NEXT_PUBLIC_HOTMART_CHECKOUT_VIP_URL=
# Grupo de WhatsApp exclusivo dos inscritos
NEXT_PUBLIC_WHATSAPP_INSCRITOS_URL=https://chat.whatsapp.com/XXXXXXXXXXXXXXXXXXXXXX
# Lista de espera da próxima turma (aparece depois do encerramento das vendas)
NEXT_PUBLIC_WAITLIST_URL=
# (NEXT_PUBLIC_SUPPORT_WHATSAPP, acima, também é o número de dúvidas da imersão)
