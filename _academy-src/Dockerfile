# ---- build: gera o site estático em /app/out ----
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# As NEXT_PUBLIC_* entram no HTML/JS na hora do build.
# No Dokploy, defina-as em "Build-time Arguments" (não em "Environment").
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_LEAD_WEBHOOK_URL
ARG NEXT_PUBLIC_WHATSAPP_GROUP_URL
ARG NEXT_PUBLIC_EBOOK_URL
ARG NEXT_PUBLIC_SUPPORT_WHATSAPP
ARG NEXT_PUBLIC_META_PIXEL_ID
ARG NEXT_PUBLIC_GA4_ID
ARG NEXT_PUBLIC_GOOGLE_ADS_ID
ARG NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL
ARG NEXT_PUBLIC_YOUTUBE_VIDEO_ID
ARG NEXT_PUBLIC_HOTMART_CHECKOUT_URL
ARG NEXT_PUBLIC_HOTMART_CHECKOUT_VIP_URL
ARG NEXT_PUBLIC_WHATSAPP_INSCRITOS_URL
ARG NEXT_PUBLIC_WAITLIST_URL
ENV NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_LEAD_WEBHOOK_URL=$NEXT_PUBLIC_LEAD_WEBHOOK_URL \
    NEXT_PUBLIC_WHATSAPP_GROUP_URL=$NEXT_PUBLIC_WHATSAPP_GROUP_URL \
    NEXT_PUBLIC_EBOOK_URL=$NEXT_PUBLIC_EBOOK_URL \
    NEXT_PUBLIC_SUPPORT_WHATSAPP=$NEXT_PUBLIC_SUPPORT_WHATSAPP \
    NEXT_PUBLIC_META_PIXEL_ID=$NEXT_PUBLIC_META_PIXEL_ID \
    NEXT_PUBLIC_GA4_ID=$NEXT_PUBLIC_GA4_ID \
    NEXT_PUBLIC_GOOGLE_ADS_ID=$NEXT_PUBLIC_GOOGLE_ADS_ID \
    NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=$NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL \
    NEXT_PUBLIC_YOUTUBE_VIDEO_ID=$NEXT_PUBLIC_YOUTUBE_VIDEO_ID \
    NEXT_PUBLIC_HOTMART_CHECKOUT_URL=$NEXT_PUBLIC_HOTMART_CHECKOUT_URL \
    NEXT_PUBLIC_HOTMART_CHECKOUT_VIP_URL=$NEXT_PUBLIC_HOTMART_CHECKOUT_VIP_URL \
    NEXT_PUBLIC_WHATSAPP_INSCRITOS_URL=$NEXT_PUBLIC_WHATSAPP_INSCRITOS_URL \
    NEXT_PUBLIC_WAITLIST_URL=$NEXT_PUBLIC_WAITLIST_URL \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# ---- runtime: nginx servindo /out ----
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
