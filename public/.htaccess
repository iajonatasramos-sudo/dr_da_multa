DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /

RewriteEngine On

# HTTPS e domínio sem www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://drdamultatelecom.com.br%{REQUEST_URI} [R=301,L]

# URLs antigas do WordPress
RewriteRule ^recursos-multa-telecom/?$ / [R=301,L]
RewriteRule ^ebook/?$ /guia-do-consumidor-de-telecomunicacoes/ [R=301,L]
RewriteRule ^thanks/?$ / [R=301,L]
RewriteRule ^(v2|teste|sample-page|hello-world)/?$ / [R=301,L]
RewriteRule ^(guia-do-consumidor-de-telecomunicacoes|thanks/obrigado-ebook-guia-do-consumidor-de-telecomunicacoes)$ /$1/ [R=301,L]

# Arquivos que estavam em wp-content/uploads (links antigos e e-mails de compra)
RewriteRule ^wp-content/uploads/2026/03/Guia_Consumidor_Telecomunicacoes_Completo\.pdf$ /downloads/Guia_Consumidor_Telecomunicacoes_Completo.pdf [R=301,L]
RewriteRule ^wp-content/uploads/2026/03/((cropped-)?Logo-[A-Za-z0-9-]+\.png)$ /assets/img/$1 [R=301,L]

<IfModule mod_headers.c>
    <FilesMatch "\.pdf$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>
